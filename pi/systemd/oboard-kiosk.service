[Unit]
Description=O Board TV display (Chromium kiosk on HDMI via cage)
After=oboard.service systemd-user-sessions.service seatd.service plymouth-quit-wait.service
Wants=oboard.service seatd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=oboard
Group=oboard
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/oboard/oboard.env
ExecStart=/opt/oboard/pi/kiosk.sh
# If the browser or the compositor crashes, bring the TV back.
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target multi-user.target
