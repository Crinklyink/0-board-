[Unit]
Description=O Board server (boards, sync, Gemini)
Documentation=file:///opt/oboard/pi/README.md
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=oboard
Group=oboard
EnvironmentFile=/etc/oboard/oboard.env
Environment=NODE_ENV=production
# The server is small; cap the JS heap so a runaway can never starve the TV browser of RAM on a 4 GB Pi.
Environment=NODE_OPTIONS=--max-old-space-size=384
WorkingDirectory=/opt/oboard/server
ExecStart=/opt/node/bin/node /opt/oboard/server/src/index.js
Restart=always
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGTERM

# Sandboxing: it can only write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/oboard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=900M

[Install]
WantedBy=multi-user.target
