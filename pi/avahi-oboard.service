<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Lets the O Board phone app find this Pi on the home network without typing an address. -->
<service-group>
  <name replace-wildcards="yes">O Board on %h</name>
  <service>
    <type>_oboard._tcp</type>
    <port>8080</port>
    <txt-record>v=1</txt-record>
  </service>
</service-group>
